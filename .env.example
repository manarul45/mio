# ==============================================================================
# MIO LEARNING ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` lalu lengkapi dengan kredensial proyek Anda:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (WAJIB)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
# ------------------------------------------------------------------------------
# URL Proyek Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Digunakan oleh frontend browser untuk interaksi publik)
SUPABASE_KEY=your-supabase-anon-key

# Secret Service Role Key (WAJIB untuk Server Nuxt, Import SQL Admin, & Bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. STORAGE / CLOUDFLARE R2 OBJECT STORAGE (OPSIONAL)
# Digunakan untuk penyimpanan materi kursus, aset, atau video jika menggunakan Cloudflare R2
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 3. WHATSAPP GATEWAY (OPSIONAL)
# Digunakan untuk notifikasi WhatsApp otomatis via Fonnte Gateway
# ------------------------------------------------------------------------------
FONNTE_API_TOKEN=
